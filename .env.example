# ---------------------------------------------------------------------------
# Structa environment variables. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are sent to the browser — only put public values there.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (accounts + progress sync) -----------------------------------
# Project Settings → API. Without these, the app runs in device-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC. Used only by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paddle (subscriptions) -------------------------------------------------
# Client-side token and price ids are public by design.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL=
# SERVER ONLY
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Development only --------------------------------------------------------
# Unlocks all 33 days without a subscription. Ignored in production builds.
# DEV_UNLOCK_ALL=true
