{
  "name": "structa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lessons": "E2E_ALL_LESSONS=1 E2E_PORT=3300 playwright test tests/e2e/all-lessons.spec.ts --project=desktop",
